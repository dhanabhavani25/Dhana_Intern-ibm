from flask import Flask, render_template, request, jsonify
import pandas as pd
import joblib

app = Flask(__name__)

# Load data
df = pd.read_csv('data/Global_AI_Agent_Workforce_Integration_2026.csv')
model_roi = joblib.load('model_roi.pkl')
model_prod = joblib.load('model_prod.pkl')
encoders = joblib.load('encoders.pkl')

@app.route('/')
def home():
    stats = {
        "total": len(df),
        "avg_prod": round(df['Productivity_Gain_Percent'].mean(), 2),
        "avg_roi": round(df['Months_To_Positive_ROI'].mean(), 2),
        "total_agents": int(df['Autonomous_Agents_Deployed'].sum()),
        "industries": sorted(df['Industry'].unique()),
        "roles": sorted(df['Primary_AI_Agent_Role'].unique()),
        "sizes": sorted(df['Company_Size'].unique())
    }
    return render_template('index.html', stats=stats, data=df.to_dict('records')[:10])

@app.route('/predict', methods=['POST'])
def predict():
    d = request.json
    X = [[
        encoders['industry'].transform([d['industry']])[0],
        encoders['size'].transform([d['size']])[0],
        encoders['role'].transform([d['role']])[0],
        int(d['agents']), float(d['cost']), int(d['governance'])
    ]]
    roi = model_roi.predict(X)[0]
    prod = model_prod.predict(X)[0]
    return jsonify({"roi": round(float(roi),2), "productivity": round(float(prod),2)})

@app.route('/api/insights')
def insights():
    return jsonify({
        "by_industry": df.groupby('Industry')['Productivity_Gain_Percent'].mean().to_dict(),
        "by_governance": df.groupby('Has_Strict_AI_Governance')['Security_Incidents_Per_Year'].mean().to_dict()
    })

if __name__ == '__main__':
    app.run(debug=True)